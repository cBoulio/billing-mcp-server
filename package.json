{
  "name": "billing-mcp-server",
  "version": "0.1.0",
  "description": "An MCP server that connects Claude to a fictional billing system, with refund policy enforced server-side.",
  "license": "MIT",
  "author": "Caleb Boulio",
  "private": true,
  "type": "module",
  "bin": {
    "larkspur-billing-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
